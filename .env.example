# No API keys are required — every tool uses public DNS, TLS and WHOIS.
# These variables only matter when running the HTTP (self-hosted) transport.

# Transport: "stdio" (default, for Claude Desktop / Claude Code) or "http".
TRANSPORT=stdio

# HTTP transport only. Safe by default: loopback bind, localhost Host/Origin only.
PORT=3000
HOST=127.0.0.1
# Hostnames the Host header may carry when exposed (e.g. mcp.example.com).
ALLOWED_HOSTS=
# Origins allowed to call from a browser.
ALLOWED_ORIGINS=
# If set, every request needs "Authorization: Bearer <token>".
MCP_AUTH_TOKEN=
