# No API keys are required — every tool uses public DNS, TLS and WHOIS.
# These variables only matter when running the HTTP (self-hosted) transport.

# Transport: "stdio" (default, for Claude Desktop / Claude Code) or "http".
TRANSPORT=stdio

# HTTP transport only:
PORT=3000
HOST=0.0.0.0
# Comma-separated Origin allowlist for DNS-rebinding protection. Leave empty to
# allow all origins (fine behind a trusted reverse proxy such as Coolify/Traefik).
ALLOWED_ORIGINS=
